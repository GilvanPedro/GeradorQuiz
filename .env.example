# Copie este arquivo para .env (que fica fora do Git) e troque pelos valores reais.

# String de conexão da Neon (botão "Connect" no painel). Sem ela, a API usa um banco em memória.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require

# Endereços do site que podem chamar a API, separados por vírgula. Em produção, a URL da Vercel.
# CORS_ORIGENS=https://quizlab.vercel.app
